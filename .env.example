# ---- Base de données (Vercel Postgres / Neon / Supabase — toutes compatibles) ----
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ---- Session (générer une chaîne aléatoire longue, ex: openssl rand -base64 48) ----
JWT_SECRET="change-moi-en-une-longue-chaine-aleatoire"

# ---- Envoi d'e-mails (codes de vérification) via Resend (gratuit jusqu'à 3000 mails/mois) ----
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Discord Bot Manager <onboarding@resend.dev>"

# ---- OAuth Discord (pour lier le compte Discord de l'utilisateur et lister ses serveurs) ----
DISCORD_CLIENT_ID="xxxxxxxxxxxxxxxxxx"
DISCORD_CLIENT_SECRET="xxxxxxxxxxxxxxxxxx"
DISCORD_REDIRECT_URI="http://localhost:3000/api/discord/oauth/callback"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
